{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/for", "destination": "/api/for" },
    { "source": "/made", "destination": "/" }
  ],
  "functions": { "api/for.js": { "includeFiles": "bouquet.html" } },
  "headers": [
    { "source": "/bouquet-audio.mp3", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
